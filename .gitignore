# Environment — never commit secrets
.env
*.local

# Household-specific config (real names, payees, employer) — see agents/household.config.example.json
agents/household.config.json

# Dependencies
node_modules/
backend/node_modules/
frontend/node_modules/

# Next.js build output
frontend/.next/
frontend/out/

# NestJS build output
backend/dist/

# Agents build output
agents/dist/

# Runtime caches (persisted via volume mount, not committed)
backend/.cache/

# pgtyped generated files — regenerated from .sql source files, not committed
backend/generated/

# Logs
*.log
npm-debug.log*

# OS
.DS_Store
Thumbs.db

# Editor
.vscode/
.idea/

# Claude Code session memory (local only — not project docs)
.claude/projects/

#seed data
investments_seed_data/

#agent test files
test_files/
# Personal dev notes / agent planning files (contain real portfolio figures) — local only
.claude/notes/
tasks/
plans/
