# Copy this file to .env and fill in your values
# .env is gitignored — never commit it

# PostgreSQL
POSTGRES_USER=pfa
POSTGRES_PASSWORD=changeme
POSTGRES_DB=personal_finance

# Used when running migrations from your Mac terminal (outside Docker)
# Note: inside Docker, the backend uses @postgres:5432 (set in docker-compose.yml)
DATABASE_URL=postgresql://pfa:changeme@localhost:5432/personal_finance
BEAVER_PASS=pass

#Price Fetching
FINNHUB_API_KEY=api_key
GOLD_API_KEY=api_key

#Gemini API Key
GEMINI_API_KEY=api_key

# Agent service auth (shared secret between backend and agents containers)
INTERNAL_API_KEY=changeme